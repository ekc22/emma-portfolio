# ---------------------------------------------------------------------------
# CoS OS environment variables. Copy to .env.local and fill in what you use.
# ---------------------------------------------------------------------------

# Claude (required for the AI Chief of Staff, briefings and meeting extraction).
# Without it the app still runs; AI features say they are not configured.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase (production mode). Leave both empty to run in local demo mode,
# which stores data in .data/cos-os.json and signs you in as a demo user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Lets admins invite people from Settings → Access, and is used by
# `npm run setup:owner`. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The app's public address, used in invite and password-reset links.
NEXT_PUBLIC_APP_URL=

# Optional cap on AI requests per person per day (default 60).
# AI_DAILY_LIMIT=60
